#import "IO";
#import "List";
#import "String";

bake banner := String.repeat("*", 32);

struct Greeter {
    target: string;
    times:  int := 1;

    def run() {
        io.print("\{banner}\n");
        for _ in 0 ..< times {
            io.print("Hello, \{target}!\n");
        }
        io.print("\{banner}\n");
    }
}

enum Shape {
    circle(radius: float),
    box(width: float, height: float),
}

def area(shape: Shape) -> float {
    return match shape {
        .circle(r) => 3.14159 * r * r,
        .box(w, h) => w * h,
    };
}

def parse_count(text: string) -> int! {
    var count := 0;
    for c in text {
        if c < '0' or c > '9' {
            return fail("not a digit");
        }
        count := count * 10 + (c - '0');
    }
    return count;
}

def main(arguments: List[string]) -> int {
    greeter := Greeter { target = "World", times = 2 };
    greeter.run();

    shape := .circle(1.5);
    io.print("area: \{area(shape)}\n");

    count := parse_count("42")!;
    io.print("count: \{count}\n");

    return 0;
}
